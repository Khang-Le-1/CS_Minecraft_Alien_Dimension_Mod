+      check(
+          !FacilitySpawnProtection.blocked(level, scientist, MobSpawnType.STRUCTURE),
+          "authored scientist placement preserved");
+      check(
+          FacilitySpawnProtection.blocked(level, scientist, MobSpawnType.NATURAL),
